# llmCli C++ - Exemplo de Configuração de Variáveis de Ambiente
# Copie este arquivo para .env (cp .env.example .env) e preencha suas chaves

# ==========================================
# 🌐 Provedores de LLM em Nuvem
# ==========================================
GEMINI_API_KEY=sua_chave_gemini_aqui
OPENAI_API_KEY=sua_chave_openai_aqui
ANTHROPIC_API_KEY=sua_chave_anthropic_aqui
DEEPSEEK_API_KEY=sua_chave_deepseek_aqui
GROQ_API_KEY=sua_chave_groq_aqui
OPENROUTER_API_KEY=sua_chave_openrouter_aqui

# ==========================================
# 🔍 Pesquisa na Web (Opcional - DuckDuckGo gratuito ativo por padrão)
# ==========================================
TAVILY_API_KEY=sua_chave_tavily_aqui

# ==========================================
# 🖥️ Endpoints de Provedores Locais
# ==========================================
LLAMACPP_BASE_URL=http://localhost:8080
OLLAMA_BASE_URL=http://localhost:11434
LMSTUDIO_BASE_URL=http://localhost:1234/v1
VLLM_BASE_URL=http://localhost:8000/v1

# ==========================================
# ⚙️ Configurações Padrão da Sessão
# ==========================================
DEFAULT_MODEL=gemini/gemini-2.5-flash
ARCHITECT_MODEL=gemini/gemini-2.5-pro
LLMCLI_LANG=pt-BR
YOLO_MODE=false
OPENAI_CODEX_MODEL=gpt-4o
